{
  "name": "kinpay-auth-core",
  "version": "0.4.0",
  "type": "module",
  "description": "KinPay shared auth core — headless session store + API client, plus the shared auth-screen UI (subpath ./ui). Each app wires behavior; the screens own their look.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/react": "^19.0.0",
    "esbuild": "0.27.4",
    "react": "^19.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kinpay-Me/auth-core.git"
  }
}
